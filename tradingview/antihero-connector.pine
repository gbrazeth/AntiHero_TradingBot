// ─────────────────────────────────────────────────────────────────────────────
// AntiHero Trading Bot — TradingView Webhook Connector v2.2 (Setup Pedro)
// ─────────────────────────────────────────────────────────────────────────────
//
// REGRAS OFICIAIS DO SETUP:
//   1. Gatilho de Entrada: Cruzamento da SMA 9 com a WMA 250
//      - LONG:  SMA 9 cruza ACIMA da WMA 250
//      - SHORT: SMA 9 cruza ABAIXO da WMA 250
//   2. Filtro WMA 250 (1%):
//      - LONG:  Se Preço > WMA 250 + 1% → NÃO entra (bloqueia topo)
//      - SHORT: Se Preço < WMA 250 - 1% → NÃO entra (bloqueia fundo)
//   3. Stop Loss: 1,0% no preço (gerenciado pelo robô na Binance)
//   4. Trava 1D: Desativada
//
// COMO CRIAR O ALERTA NO TRADINGVIEW:
//   1. Adicione este indicador ao gráfico ETHUSDT (1H)
//   2. Clique no ícone de Alarme ("Criar Alerta")
//   3. Condição: Selecione "AntiHero Webhook Connector (Setup Pedro)" → "Qualquer chamada de função de alerta()"
//   4. Notificações: Marque "URL do Webhook" e insira:
//      https://antihero-tradingbot.onrender.com/webhook/tradingview?token=dev-token-change-me
//   5. Mensagem: Deixe em branco (o script já envia o JSON correto)
//   6. Clique em "Criar"
// ─────────────────────────────────────────────────────────────────────────────

//@version=6
indicator("AntiHero Webhook Connector (Setup Pedro)", overlay=true)

// ══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════════════════════

strategy_id    = input.string("PEDRO_MVP_V1", "Strategy ID", group="Configuração do Bot")
sma_len        = input.int(9,   "SMA Curta",  group="Médias Móveis")
wma_len        = input.int(250, "WMA Longa",  group="Médias Móveis")

// Filtro de 1% da WMA 250 (Regra Pedro)
use_wma_filter = input.bool(true,  "Ativar Filtro de 1% da WMA 250", group="Filtro WMA 250")
wma_threshold  = input.float(2.0,  "Distância Limite WMA (%)", step=0.1, group="Filtro WMA 250") / 100

// ══════════════════════════════════════════════════════════════════════════════
// CÁLCULOS DAS MÉDIAS
// ══════════════════════════════════════════════════════════════════════════════

sma_9   = ta.sma(close, sma_len)
wma_250 = ta.wma(close, wma_len)

// Cruzamentos
sma_cross_up   = ta.crossover(sma_9, wma_250)
sma_cross_down = ta.crossunder(sma_9, wma_250)

// Verificação da Regra de 1% da WMA 250
bool is_wma_ok_long  = not use_wma_filter or (close <= wma_250 * (1 + wma_threshold))
bool is_wma_ok_short = not use_wma_filter or (close >= wma_250 * (1 - wma_threshold))

// Entradas Validadas
bool entry_long_valid  = sma_cross_up   and is_wma_ok_long
bool entry_short_valid = sma_cross_down and is_wma_ok_short

// ══════════════════════════════════════════════════════════════════════════════
// PLOTS VISUAIS NO GRÁFICO
// ══════════════════════════════════════════════════════════════════════════════

plot(wma_250, "WMA 250", color=color.new(color.purple, 20), linewidth=2)
plot(sma_9,   "SMA 9",   color=color.new(color.orange, 20), linewidth=1)

// Faixa permitida do 1% da WMA 250
p_top = plot(wma_250 * (1 + wma_threshold), "WMA +1%", color=color.new(color.red, 75), style=plot.style_circles)
p_bot = plot(wma_250 * (1 - wma_threshold), "WMA -1%", color=color.new(color.green, 75), style=plot.style_circles)
fill(p_top, p_bot, color=color.new(color.purple, 94), title="Faixa Permitida WMA (1%)")

// Sinais no Gráfico
plotshape(entry_long_valid,  "LONG Entry",  shape.triangleup,   location.belowbar, color=color.green, size=size.normal)
plotshape(entry_short_valid, "SHORT Entry", shape.triangledown, location.abovebar, color=color.red,   size=size.normal)

// Marcador quando o cruzamento é bloqueado pelo 1%
plotshape(sma_cross_up and not is_wma_ok_long,   "LONG Bloqueado (>1% WMA)", shape.xcross, location.belowbar, color=color.orange, size=size.small)
plotshape(sma_cross_down and not is_wma_ok_short, "SHORT Bloqueado (>1% WMA)", shape.xcross, location.abovebar, color=color.orange, size=size.small)

// ══════════════════════════════════════════════════════════════════════════════
// WEBHOOK ALERTS (DISPARO PARA O BOT)
// ══════════════════════════════════════════════════════════════════════════════

tf_str  = timeframe.period
wma_str = str.tostring(wma_250, "#.##")

if entry_long_valid
    alert('{"strategy_id":"' + strategy_id + '","exchange":"BINANCE_TESTNET","symbol":"' + syminfo.ticker + '","timeframe":"' + tf_str + '","price":' + str.tostring(close) + ',"timestamp":"' + str.format_time(timenow, "yyyy-MM-dd\'T\'HH:mm:ss\'Z\'", "UTC") + '","bar_close":false,"event":"SMA_ENTRY_LONG","wma_250":' + wma_str + '}', alert.freq_once_per_bar)

if entry_short_valid
    alert('{"strategy_id":"' + strategy_id + '","exchange":"BINANCE_TESTNET","symbol":"' + syminfo.ticker + '","timeframe":"' + tf_str + '","price":' + str.tostring(close) + ',"timestamp":"' + str.format_time(timenow, "yyyy-MM-dd\'T\'HH:mm:ss\'Z\'", "UTC") + '","bar_close":false,"event":"SMA_ENTRY_SHORT","wma_250":' + wma_str + '}', alert.freq_once_per_bar)
