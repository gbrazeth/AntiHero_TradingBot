//@version=6
strategy("AntiHero Bot v2.1 — Backtester & Setup Pedro",
     overlay        = true,
     initial_capital = 2000,
     default_qty_type = strategy.cash,
     default_qty_value = 100,
     commission_type  = strategy.commission.percent,
     commission_value = 0.04,
     slippage        = 1,
     pyramiding      = 1,
     process_orders_on_close = false,
     calc_on_every_tick = false,
     margin_long     = 5,
     margin_short    = 5)

// ══════════════════════════════════════════════════════════════════════════════
// INPUTS — Configurações do Setup
// ══════════════════════════════════════════════════════════════════════════════

// 1. Gatilho de Entrada
trigger_type = input.string("SMA 9 x WMA 250", "Gatilho Principal de Entrada", 
     options=["SMA 9 x WMA 250", "Preco x SMA 9", "MACD Crossover"], group="1. Gatilho de Entrada")

// 2. Filtro WMA 250 (Regra Pedro 24/08)
wma_rule = input.string("Bloquear se > 1% (Regra Pedro)", "Regra WMA 250",
     options=["Bloquear se > 1% (Regra Pedro)", "Meio Lote + DCA (Regra Antiga)", "Sem Filtro WMA"], group="2. Filtro WMA 250")
wma_threshold = input.float(1.0, "Distancia Limite WMA (%)", step=0.1, group="2. Filtro WMA 250") / 100

// 3. Filtro de Tendencia 1D (EMA 200)
use_trend_filter = input.bool(true, "Ativar Filtro Tendencia 1D (EMA 200)", group="3. Filtro 1D")
trend_ema_len    = input.int(200, "Periodo EMA 1D", group="3. Filtro 1D")

// 4. Parametros Indicadores
sma_len     = input.int(9,   "Periodo SMA Curta", group="4. Indicadores")
wma_len     = input.int(250, "Periodo WMA Longa", group="4. Indicadores")
macd_fast   = input.int(12,  "MACD Fast", group="4. Indicadores")
macd_slow   = input.int(26,  "MACD Slow", group="4. Indicadores")
macd_signal = input.int(9,   "MACD Signal", group="4. Indicadores")

// 5. Gestao de Risco
leverage    = input.int(20,    "Alavancagem",   group="5. Risco")
sl_pct      = input.float(1.0, "Stop Loss (%)", step=0.1, group="5. Risco") / 100
lot_usdt    = input.float(100, "Lote (USDT)",   step=10,  group="5. Risco")

// ══════════════════════════════════════════════════════════════════════════════
// CALCULOS
// ══════════════════════════════════════════════════════════════════════════════

sma_9   = ta.sma(close, sma_len)
wma_250 = ta.wma(close, wma_len)
[macdL, sigL, _] = ta.macd(close, macd_fast, macd_slow, macd_signal)
ema_1d  = request.security(syminfo.tickerid, "D", ta.ema(close, trend_ema_len))

// Cruzamentos
sma_cross_wma_up   = ta.crossover(sma_9, wma_250)
sma_cross_wma_down = ta.crossunder(sma_9, wma_250)

price_cross_sma_up   = ta.crossover(close, sma_9)
price_cross_sma_down = ta.crossunder(close, sma_9)

macd_cross_up   = ta.crossover(macdL, sigL)
macd_cross_down = ta.crossunder(macdL, sigL)

trend_up   = close > ema_1d
trend_down = close < ema_1d

// Selecao do Gatilho
bool raw_long  = false
bool raw_short = false

if trigger_type == "SMA 9 x WMA 250"
    raw_long  := sma_cross_wma_up
    raw_short := sma_cross_wma_down
else if trigger_type == "Preco x SMA 9"
    raw_long  := price_cross_sma_up
    raw_short := price_cross_sma_down
else // MACD Crossover
    raw_long  := macd_cross_up
    raw_short := macd_cross_down

// Aplicacao dos Filtros
bool pass_1d_long  = not use_trend_filter or trend_up
bool pass_1d_short = not use_trend_filter or trend_down

bool is_dist_wma_long  = close > wma_250 * (1 + wma_threshold)
bool is_dist_wma_short = close < wma_250 * (1 - wma_threshold)

bool entry_L = false
bool entry_S = false

if wma_rule == "Bloquear se > 1% (Regra Pedro)"
    entry_L := raw_long  and pass_1d_long  and not is_dist_wma_long
    entry_S := raw_short and pass_1d_short and not is_dist_wma_short
else
    entry_L := raw_long  and pass_1d_long
    entry_S := raw_short and pass_1d_short

// ══════════════════════════════════════════════════════════════════════════════
// EXECUCAO DA ESTRATEGIA
// ══════════════════════════════════════════════════════════════════════════════

var float ep      = na
var bool  iL      = false
var bool  iS      = false
var bool  iHalf   = false
var bool  dcaDone = false
var float oQty    = 0.0
var float cQty    = 0.0
var float sl_v    = na
var bool tp1=false, tp2=false, tp3=false, tp4=false, tp5=false
var bool tp6=false, tp7=false, tp8=false, tp9=false, tp10=false
var bool tp11=false, tp12=false, tp13=false
var int trades = 0, dcas = 0

get_roi(float e, float c, bool lg) =>
    float p = lg ? (c - e) / e : (e - c) / e
    p * leverage * 100

// Auto-Reversao
if entry_L and iS
    strategy.close_all(comment="Rev LONG")
    iS:=false
    tp1:=false
    tp2:=false
    tp3:=false
    tp4:=false
    tp5:=false
    tp6:=false
    tp7:=false
    tp8:=false
    tp9:=false
    tp10:=false
    tp11:=false
    tp12:=false
    tp13:=false

if entry_S and iL
    strategy.close_all(comment="Rev SHORT")
    iL:=false
    tp1:=false
    tp2:=false
    tp3:=false
    tp4:=false
    tp5:=false
    tp6:=false
    tp7:=false
    tp8:=false
    tp9:=false
    tp10:=false
    tp11:=false
    tp12:=false
    tp13:=false

// Entrada LONG
if entry_L and not iL
    bool half = (wma_rule == "Meio Lote + DCA (Regra Antiga)") and is_dist_wma_long
    float q = (half ? lot_usdt/2 : lot_usdt) / close
    strategy.entry("LONG", strategy.long, qty=q, comment=half ? "LONG (½)" : "LONG")
    ep:=close
    iL:=true
    iS:=false
    iHalf:=half
    dcaDone:=false
    oQty:=q
    cQty:=q
    sl_v:=close * (1 - sl_pct)
    trades+=1
    tp1:=false
    tp2:=false
    tp3:=false
    tp4:=false
    tp5:=false
    tp6:=false
    tp7:=false
    tp8:=false
    tp9:=false
    tp10:=false
    tp11:=false
    tp12:=false
    tp13:=false

// Entrada SHORT
if entry_S and not iS
    bool half = (wma_rule == "Meio Lote + DCA (Regra Antiga)") and is_dist_wma_short
    float q = (half ? lot_usdt/2 : lot_usdt) / close
    strategy.entry("SHORT", strategy.short, qty=q, comment=half ? "SHORT (½)" : "SHORT")
    ep:=close
    iL:=false
    iS:=true
    iHalf:=half
    dcaDone:=false
    oQty:=q
    cQty:=q
    sl_v:=close * (1 + sl_pct)
    trades+=1
    tp1:=false
    tp2:=false
    tp3:=false
    tp4:=false
    tp5:=false
    tp6:=false
    tp7:=false
    tp8:=false
    tp9:=false
    tp10:=false
    tp11:=false
    tp12:=false
    tp13:=false

// Stop Loss
if iL and not na(sl_v)
    strategy.exit("SL", "LONG",  stop=sl_v)
if iS and not na(sl_v)
    strategy.exit("SL", "SHORT", stop=sl_v)

// DCA (caso ativado no modo antigo)
if (iL or iS) and iHalf and not dcaDone and not na(ep)
    if get_roi(ep, close, iL) <= -20.0
        float dq = oQty
        if iL
            strategy.entry("LONG",  strategy.long,  qty=dq, comment="DCA")
        else
            strategy.entry("SHORT", strategy.short, qty=dq, comment="DCA")
        float nq = cQty + dq
        float ne = (ep * cQty + close * dq) / nq
        sl_v    := iL ? ne*(1 + (-0.20/leverage)) : ne*(1 - (-0.20/leverage))
        ep      := ne
        cQty    := nq
        dcaDone := true
        dcas    += 1

// Take Profits Nativos
if (iL or iS) and not na(ep) and strategy.position_size != 0
    float roi = get_roi(ep, close, iL)
    string id = iL ? "LONG" : "SHORT"
    if not tp1  and roi >= 10
        strategy.close(id, qty_percent=10, comment="TP1 10%")
        tp1:=true
    if not tp2  and roi >= 20
        strategy.close(id, qty_percent=11, comment="TP2 20%")
        tp2:=true
    if not tp3  and roi >= 25
        strategy.close(id, qty_percent=12, comment="TP3 25%")
        tp3:=true
    if not tp4  and roi >= 33
        strategy.close(id, qty_percent=14, comment="TP4 33%")
        tp4:=true
    if not tp5  and roi >= 50
        strategy.close(id, qty_percent=17, comment="TP5 50%")
        tp5:=true
    if not tp6  and roi >= 75
        strategy.close(id, qty_percent=20, comment="TP6 75%")
        tp6:=true
    if not tp7  and roi >= 100
        strategy.close(id, qty_percent=25, comment="TP7 100%")
        tp7:=true
    if not tp8  and roi >= 150
        strategy.close(id, qty_percent=17, comment="TP8 150%")
        tp8:=true
    if not tp9  and roi >= 200
        strategy.close(id, qty_percent=20, comment="TP9 200%")
        tp9:=true
    if not tp10 and roi >= 250
        strategy.close(id, qty_percent=25, comment="TP10 250%")
        tp10:=true
    if not tp11 and roi >= 300
        strategy.close(id, qty_percent=33, comment="TP11 300%")
        tp11:=true
    if not tp12 and roi >= 400
        strategy.close(id, qty_percent=50, comment="TP12 400%")
        tp12:=true
    if not tp13 and roi >= 500
        strategy.close(id, qty_percent=100, comment="TP13 500%")
        tp13:=true
        iL:=false
        iS:=false

if strategy.position_size == 0 and (iL or iS)
    iL:=false
    iS:=false

// Plots
plot(wma_250, "WMA 250", color.new(color.purple, 20), linewidth=2)
plot(sma_9,   "SMA 9",   color.new(color.orange, 20), linewidth=1)
plot(ema_1d,  "EMA 1D",  color.new(color.gray, 50),   linewidth=1, style=plot.style_cross)
plot(iL or iS ? sl_v : na, "SL", color.new(color.red, 30), style=plot.style_linebr)

// Faixa de bloqueio de 1% da WMA 250
p_wma_high = plot(wma_250 * (1 + wma_threshold), "WMA +1%", color.new(color.red, 70), style=plot.style_circles)
p_wma_low  = plot(wma_250 * (1 - wma_threshold), "WMA -1%", color.new(color.green, 70), style=plot.style_circles)
fill(p_wma_high, p_wma_low, color=color.new(color.purple, 92), title="Zona Permitida WMA")

var table tb = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 75), border_width=1)
if barstate.islast
    table.cell(tb, 0, 0, "AntiHero v2.1 Setup Pedro", text_color=color.white, bgcolor=color.new(color.blue, 50), text_halign=text.align_center)
    table.merge_cells(tb, 0, 0, 1, 0)
    table.cell(tb, 0, 1, "Gatilho",  text_color=color.gray, text_size=size.small)
    table.cell(tb, 1, 1, trigger_type, text_color=color.yellow, text_size=size.small)
    table.cell(tb, 0, 2, "Filtro WMA", text_color=color.gray, text_size=size.small)
    table.cell(tb, 1, 2, wma_rule == "Bloquear se > 1% (Regra Pedro)" ? "Bloq >1%" : "Meio Lote", text_color=color.aqua, text_size=size.small)
    table.cell(tb, 0, 3, "Stop Loss", text_color=color.gray, text_size=size.small)
    table.cell(tb, 1, 3, str.tostring(sl_pct * 100, "#.#") + "%", text_color=color.red, text_size=size.small)
    table.cell(tb, 0, 4, "Total Trades", text_color=color.gray, text_size=size.small)
    table.cell(tb, 1, 4, str.tostring(trades), text_color=color.white, text_size=size.small)
